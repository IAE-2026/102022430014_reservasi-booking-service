{
    "swagger": "2.0",
    "info": {
        "description": "API untuk layanan reservasi booking hotel (IAE Tubes)",
        "title": "Layanan Reservasi API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/bookings": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Mendapatkan daftar seluruh reservasi (kebutuhan kontrak API)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bookings"
                ],
                "summary": "Mengambil semua pesanan (Collection)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "API Key",
                        "name": "X-IAE-KEY",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Bearer JWT Token dari SSO",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/domain.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/domain.Booking"
                                            }
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Endpoint untuk membuat reservasi awal dengan status LOCKED. Terintegrasi dengan SOAP Audit dan Message Broker.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bookings"
                ],
                "summary": "Membuat pesanan awal (mengunci kamar)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "API Key",
                        "name": "X-IAE-KEY",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Bearer JWT Token dari SSO",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Kunci unik untuk mencegah duplikasi request",
                        "name": "Idempotency-Key",
                        "in": "header"
                    },
                    {
                        "description": "Payload Reservasi",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.CreateBookingRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/domain.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.Booking"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/bookings/{id}": {
            "get": {
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "description": "Mendapatkan rincian spesifik satu reservasi berdasarkan ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Bookings"
                ],
                "summary": "Mengambil detail pesanan (Resource)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "API Key",
                        "name": "X-IAE-KEY",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Bearer JWT Token dari SSO",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Booking ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/domain.SuccessResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/domain.Booking"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.Booking": {
            "type": "object",
            "properties": {
                "addons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.BookingAddon"
                    }
                },
                "check_in_date": {
                    "type": "string"
                },
                "check_out_date": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "expires_at": {
                    "type": "string"
                },
                "grand_total": {
                    "type": "number"
                },
                "guest_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "receipt_number": {
                    "type": "string"
                },
                "room_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "total_addons_price": {
                    "type": "number"
                },
                "total_room_price": {
                    "type": "number"
                }
            }
        },
        "domain.BookingAddon": {
            "type": "object",
            "properties": {
                "addon_id": {
                    "type": "string"
                },
                "booking_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "price_at_booking": {
                    "type": "number"
                },
                "quantity": {
                    "type": "integer"
                }
            }
        },
        "domain.CreateBookingRequest": {
            "type": "object",
            "required": [
                "check_in_date",
                "check_out_date",
                "guest_id",
                "room_id"
            ],
            "properties": {
                "check_in_date": {
                    "description": "format YYYY-MM-DD",
                    "type": "string"
                },
                "check_out_date": {
                    "description": "format YYYY-MM-DD",
                    "type": "string"
                },
                "guest_id": {
                    "type": "string"
                },
                "room_id": {
                    "type": "string"
                }
            }
        },
        "domain.ErrorResponse": {
            "type": "object",
            "properties": {
                "errors": {
                    "description": "Opsional: Detail error validasi"
                },
                "message": {
                    "description": "Detail pesan kesalahan",
                    "type": "string"
                },
                "status": {
                    "description": "Biasanya diisi \"error\" atau \"fail\"",
                    "type": "string"
                }
            }
        },
        "domain.Meta": {
            "type": "object",
            "properties": {
                "api_version": {
                    "type": "string"
                },
                "service_name": {
                    "type": "string"
                }
            }
        },
        "domain.SuccessResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "Objek atau Array data utama"
                },
                "message": {
                    "description": "Pesan sukses",
                    "type": "string"
                },
                "meta": {
                    "description": "Informasi tambahan (opsional)",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Meta"
                        }
                    ]
                },
                "status": {
                    "description": "Biasanya diisi \"success\"",
                    "type": "string"
                }
            }
        }
    }
}